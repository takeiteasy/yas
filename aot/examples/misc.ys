;; Exercises let/let*, float promotion, and mutual recursion for
;; aot/tests/plan_test.c. AOT subset only - see docs/AOT.md.

(define (let-test x)
  (let ((a (+ x 1))
        (b (* x 2)))
    (+ a b)))

(define (let-star-test x)
  (let* ((a (+ x 1))
         (b (* a 2)))
    (+ a b)))

(define pi 3.14159)

(define (circle-area r)
  (* pi (* r r)))

(define (mutual-even n)
  (if (= n 0) 1 (mutual-odd (- n 1))))

(define (mutual-odd n)
  (if (= n 0) 0 (mutual-even (- n 1))))
