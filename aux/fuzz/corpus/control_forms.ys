; Control forms and macros - evaluator + defmacro expansion paths
(define x 10)
(set! x (+ x 32))
(if (> x 5) 'big 'small)
(when (= x 42) 'answer)
(unless (= x 0) 'nonzero)
(cond ((= x 1) 'one) ((= x 42) 'forty-two) (else 'other))
(let ((a 1) (b 2)) (+ a b))
(let* ((a 1) (b (* a 2))) b)
(lambda (n) (* n n))
((lambda (n) (* n n)) 7)
(defmacro (inc v) `(+ ,v 1))
(inc x)
(begin 1 2 3)
(and 1 2 3)
(or nil 5)
(dotimes (i 4) i)
(dolist (e '(a b c)) e)
(for i 0 3 i)
(while nil 'never)
(foldl + 0 '(1 2 3 4))
(map car '((1 2) (3 4)))
(filter pair? '(1 (2) 3 (4)))
