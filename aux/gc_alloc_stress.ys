;; Dedicated audit target for allocation-triggered GC stepping (docs/GC.md,
;; "Allocation-triggered stepping"). Run with YAS_GC_STRESS=1 (shrinks the
;; cycle-start threshold and step quantum to 1 byte, so a collection cycle
;; starts and advances via the ordinary debt-paced gc_pace() path on
;; essentially every allocation, instead of only once ~256KB has
;; accumulated) so that any C-level builtin holding an unrooted local
;; across a further allocation turns into a deterministic crash instead of
;; a one-in-a-million race - ideally under ASan too, so the report names
;; the exact function:
;;
;;   YAS_GC_STRESS=1 make yas YAS_ASAN=1 && YAS_GC_STRESS=1 ./yas aux/gc_alloc_stress.ys
;;
;; (or just `make test-gc-stress YAS_ASAN=1`, which drives this file).
;;
;; Deliberately small: this file is exercised at n=1 broad-but-shallow
;; coverage; suite.ys itself is exercised separately at a much larger n
;; (see `test-gc-stress` in the Makefile) - keeping suite.ys's normal-sized
;; input out of the 1-byte-threshold path this file is dedicated to.
;;
;; Deliberately broad: touches as many allocating builtins as practical in a
;; small amount of code - list/string/hash/vector/bytevector construction,
;; string ops that allocate, and a module import (which walks the raw
;; struct YasHash* iteration loops fixed - so the audit
;; isn't limited to one code path.

(import yas/hash)
(import yas/vector)
(import yas/text)
(import yas/io)
(import yas/test)

(test "lists and pairs"
  (let loop ((i 0) (acc nil))
    (if (< i 200)
        (loop (+ i 1) (cons i acc))
        (check (length acc) 200))))

(test "strings"
  (let loop ((i 0) (s ""))
    (if (< i 100)
        (loop (+ i 1) (string-append s "x"))
        (check (string-length s) 100))))

(test "vectors"
  (let loop ((i 0) (v (make-vector 0 0)))
    (if (< i 50)
        (loop (+ i 1) (vector-append v (make-vector 1 i)))
        (check (vector-length v) 50))))

(test "hashes"
  (let ((h (make-hash)))
    (let loop ((i 0))
      (if (< i 100)
          (begin
            (hash-set! h i (* i i))
            (loop (+ i 1)))
          (check (hash-ref h 42 nil) 1764)))))

(test "bytevectors"
  (let loop ((i 0) (last ""))
    (if (< i 20)
        (loop (+ i 1) (bytevector->string (string->bytevector "needle")))
        (check last "needle"))))

(test "nested constructors (Class B hazard: temporaries with no root slot)"
  (let loop ((i 0) (acc nil))
    (if (< i 50)
        (loop (+ i 1) (cons (make-string 4 #\z) acc))
        (check (length acc) 50))))

(test "module import re-walks the import-set resolution loops"
  (import (except yas/hash h-))
  (import (prefix yas/vector v-))
  T)

(run-tests)
