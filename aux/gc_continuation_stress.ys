;; Stress/regression test for continuation GC-tracing and snapshotting.
;;
;; yas_gc_mark() (src/data.c) must trace a continuation's captured stack -
;; a chain of struct YasFrame objects since ticket #40 (previously a chain
;; of ordinary cons pairs) - the same way it traces the other GC-tracked
;; frame-family types. Before the original fix, gc_mark() returned
;; immediately for a continuation without marking its backing allocation,
;; so a continuation reachable ONLY through a binding - not through the
;; live evaluator stack at the moment gc() runs - had its frames swept and
;; use-after-freed on the next invocation.
;;
;; The key detail: capturing a continuation and invoking it again from
;; *within the same call/cc dynamic extent* does not exercise the bug,
;; because the captured frames are still part of the live stack (and
;; therefore already marked via the ordinary stack root) when gc() runs.
;; The bug only shows up once that extent has unwound *normally* and the
;; continuation is reachable solely via an environment binding - so each
;; test below captures a continuation at top level, lets its call/cc
;; return normally (unwinding the live stack), forces full GC cycles via
;; the (gc) builtin while the stashed chain is off the live stack, and
;; only then invokes it from an unrelated later form. On unfixed code this
;; segfaults.
;;
;; Ticket #58: continuations are snapshots cloned per invocation, so these
;; invocations also assert exact resumed values - the resumed computation
;; re-enters its capture-point expression (e.g. the value being defined)
;; with the supplied argument and updates that binding. Each repro sits at
;; top level deliberately: every top-level form starts with an empty VM
;; stack, so the captured chain bottoms out in its own form's frames and
;; the replay converges instead of re-entering enclosing test-runner
;; continuations (standard Scheme escape semantics).
;;
;; This file is not part of `make test` / suite.ys - it deliberately
;; forces full GC cycles between captures. Run it directly:
;;   ./yas aux/gc_continuation_stress.ys
;; (it is part of `make stress-test` / `make test-gc-stress`)

(import yas/math)
(import yas/test)

(define *k1* nil)
(define *v1* (+ 100 (call/cc (lambda (k) (set! *k1* k) 1))))
(gc) (gc)   ; force a couple of full cycles while *k1* is off the live stack
(*k1* 999)  ; resumes (+ 100 [_]) with 999 and re-defines *v1*

(test "a continuation stashed off the live stack survives GC, invoked from a later form"
  ;; The invoke above re-defined *v1* by resuming its capture-point
  ;; expression; 101 here would mean the resumed frames were corrupted
  ;; or swept.
  (check *v1* 1099))

(define *k2* nil)
(define *v2* (* 3 (call/cc (lambda (k) (set! *k2* k) 7))))
(gc) (gc)   ; further pressure, plus prior continuation use
(*k2* 5)    ; resumes (* 3 [_]) with 5 and re-defines *v2*

(test "a second continuation stays valid after further GC pressure and prior continuation use"
  (check *v2* 15))

;; Churn loop (ticket #40): capture, drop, and re-invoke a fresh
;; continuation many times across forced GC cycles, so
;; YAS_GC_OBJ_FRAME's gc_scan_object() arm (data.c) - which must mark
;; every captured frame's parent/env/op/tail/args/body field - gets
;; exercised on many distinct frame chains, not just the two fixed ones
;; above. Each iteration's continuation is captured, invoked once
;; (dropping it), and immediately becomes garbage; a missed mark in the
;; frame scan arm would show up here as a crash or a wrong sum under
;; YAS_GC_STRESS=1, since every iteration's frames become collectible
;; almost immediately. Under ticket #58 semantics each invocation also
;; runs on a fresh clone of the captured chain.
(define (churn-continuations n)
  (let ((total 0))
    (dotimes (i n)
      (set! total (+ total (call/cc (lambda (k) (k i)))))
      (if (= (modulo i 10) 0) (gc) nil))
    total))

(test "capturing and dropping many continuations across forced GC cycles"
  (check (churn-continuations 200) 19900))  ; sum 0..199

(run-tests)
