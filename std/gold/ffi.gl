;; Gold FFI - High-level interface
;; 
;; This library provides convenient macros for FFI usage.
;; Use reader conditionals to check for FFI availability:
;;   #+ffi (import (gold ffi))

(define-library (gold ffi)
  (export 
    ;; High-level helpers
    library-extension
    define-foreign
    ;; Re-export low-level primitives
    ffi-open ffi-close ffi-lookup
    ffi-define ffi-call
    ffi-malloc ffi-free
    ffi-pointer-ref ffi-pointer-set!
    ffi-null ffi-null?)
  
  (import (gold base))
  
  (begin
    ;; Get the library file extension for the current platform
    (define (library-extension)
      #+macos ".dylib"
      #+windows ".dll"
      #-(or macos windows) ".so")
    
    ;; Macro: define a foreign function as a Scheme procedure
    ;; Usage: (define-foreign name lib "c_symbol" :ret-type (:arg-types...))
    ;; 
    ;; Example:
    ;;   (define libc (ffi-open "libc.dylib"))
    ;;   (define-foreign strlen libc "strlen" :uint64 (:pointer))
    ;;   (strlen "hello")  ; => 5
    (defmacro (define-foreign name lib c-name ret-type arg-types)
      `(define ,name
         (let ((fn (ffi-define (ffi-lookup ,lib ,c-name) ,ret-type ,arg-types)))
           (lambda args
             (apply ffi-call (cons fn args))))))))
