(define-library (gold text)
  (import (gold base))
  (export
    ;; String Operations
    string? string-length string-ref string=? string-append string-byte-length
    ->string
    
    ;; Format Helpers
    number->string string-upcase string-downcase string-capitalize
    make-string substring
    
    ;; Keyword Operations
    keyword? keyword->string string->keyword
    
    ;; Procedure Documentation
    procedure-doc)
  (begin))
