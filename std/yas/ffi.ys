;; YAS FFI - High-level interface over the native module's builtins.
;;
;; This module provides convenient macros for FFI usage. Use reader
;; conditionals to check for FFI availability:
;;   #+ffi (import yas/ffi)
;;
;; The native half of this module (module.c) registers the primitives:
;; ffi-open, ffi-close, ffi-lookup, ffi-define, ffi-call, ffi-malloc,
;; ffi-free, ffi-pointer-ref, ffi-pointer-set!, ffi-null, ffi-null?,
;; %ffi-defstruct, %make-ffi-struct, %ffi-struct-ref, %ffi-struct-set!
;; Base is provided automatically in every module env.

;; Get the library file extension for the current platform
(define (library-extension)
  #+macos ".dylib"
  #+windows ".dll"
  #-(or macos windows) ".so")

;; Macro: define a struct type for FFI
;; Usage: (ffi-defstruct name (field-name type) ...)
;;
;; Example:
;;   (ffi-defstruct Color (r :UINT8) (g :UINT8) (b :UINT8) (a :UINT8))
;;   (ffi-defstruct Point (x :INT32) (y :INT32))
(defmacro (ffi-defstruct name . fields)
  `(%ffi-defstruct ',name ',fields))

;; Macro: create an instance of an FFI struct
;; Usage: (make-ffi-struct type-name values...)
;;
;; Example:
;;   (define white (make-ffi-struct Color 255 255 255 255))
;;   (define p (make-ffi-struct Point 10 20))
(defmacro (make-ffi-struct type-name . values)
  `(%make-ffi-struct ',type-name ,@values))

;; Macro: read a field from an FFI struct
;; Usage: (ffi-struct-ref struct field-name)
;;
;; Example:
;;   (ffi-struct-ref p x)  ; => 10
(defmacro (ffi-struct-ref struct field-name)
  `(%ffi-struct-ref ,struct ',field-name))

;; Macro: set a field in an FFI struct
;; Usage: (ffi-struct-set! struct field-name value)
;;
;; Example:
;;   (ffi-struct-set! p x 100)
(defmacro (ffi-struct-set! struct field-name value)
  `(%ffi-struct-set! ,struct ',field-name ,value))

;; Macro: define a foreign function as a Scheme procedure
;; Usage: (define-foreign name lib "c_symbol" :ret-type (:arg-types...))
;;
;; The prepared function retains its owning library (the GC never
;; dlcloses a library while one of its extracted functions is live), so
;; the lib binding may be dropped freely after define-foreign.
;; Note the arg-types list is quoted: it is passed to ffi-define as
;; literal data, not evaluated.
;;
;; Example:
;;   (define libc (ffi-open "libc.dylib"))
;;   (define-foreign strlen libc "strlen" :uint64 (:pointer))
;;   (strlen "hello")  ; => 5
(defmacro (define-foreign name lib c-name ret-type arg-types)
  `(define ,name
     (let ((fn (ffi-define ,lib ,c-name ,ret-type ',arg-types)))
       (lambda args
         (apply ffi-call (cons fn args))))))
