;; yas/io - port/file helpers layered over the C builtins.
;; Depends on yas/text (string-join etc.); base is automatic.

(import yas/text)

;; High-level file I/O with automatic resource management
(define (call-with-input-file path proc)
  (let ((port (open-input-file path)))
    (try
      (proc port)
      (finally (close-port port)))))

(define (call-with-output-file path proc)
  (let ((port (open-output-file path)))
    (try
      (proc port)
      (finally (close-port port)))))

;; Compatibility aliases for R7RS style
(define (with-input-from-file path proc)
  (call-with-input-file path (lambda (port) (proc))))

(define (with-output-to-file path proc)
  (call-with-output-file path (lambda (port) (proc))))

;; Simple file reading/writing utilities
(define (read-file path)
  (call-with-input-file path read-all))

(define (write-file path content)
  (call-with-output-file path 
    (lambda (port) 
      (write-string content port))))

;; File Operations
(define (copy-file src dst)
  (call-with-input-file src
    (lambda (in)
      (call-with-output-file dst
        (lambda (out)
          (let loop ()
            (let ((chunk (read-bytes in 4096)))
              (if (not (eq? chunk 'EOF))
                  (begin
                    (write-bytes chunk out)
                    (loop))))))))))

;; Path Utilities
(define (path-join . parts)
  (string-join parts "/"))

(define (path-dirname path)
  (let loop ((i (- (string-length path) 1)))
    (if (< i 0)
        "."
        (if (string=? (substring path i (+ i 1)) "/")
            (if (= i 0) "/" (substring path 0 i))
            (loop (- i 1))))))

(define (path-basename path)
  (let loop ((i (- (string-length path) 1)))
    (if (< i 0)
        path
        (if (string=? (substring path i (+ i 1)) "/")
            (substring path (+ i 1) (string-length path))
            (loop (- i 1))))))

(define (path-extension path)
  (let loop ((i (- (string-length path) 1)))
    (if (< i 0)
        ""
        (if (string=? (substring path i (+ i 1)) ".")
            (substring path i (string-length path))
            (if (string=? (substring path i (+ i 1)) "/")
                ""
                (loop (- i 1)))))))
