(import (yas base))
(import (yas math))
(import (yas hash))
(import (yas vector))
(import (yas text))
(import (yas test))

(print "Running YAS Test Suite...")

(test "Arithmetic"
  (check (+ 1 2) 3)
  (check (- 5 2) 3)
  (check (* 3 4) 12)
  (check (/ 10 2) 5)
  (check (modulo 10 3) 1))

(test "Lists"
  (check (car '(1 2)) 1)
  (check (cdr '(1 2)) '(2))
  (check (cons 1 2) '(1 . 2))
  (check (list 1 2 3) '(1 2 3))
  (check (append '(1) '(2)) '(1 2))
  (check (reverse '(1 2 3)) '(3 2 1)))

(test "Control Flow"
  (check (if t 1 2) 1)
  (check (if nil 1 2) 2)
  (check (cond (nil 1) (t 2)) 2)
  ;; when/unless return nil or result
  (check (when t 1) 1)
  (check (unless nil 1) 1))

(test "Vectors"
  (let ((v (make-vector 3 0)))
    (check (vector? v) t)
    (check (vector-length v) 3)
    (vector-set! v 0 10)
    (check (vector-ref v 0) 10)
    (check v #(10 0 0))))

(test "Hash Tables"
  (let ((h (make-hash)))
    (check (hash? h) t)
    (hash-set! h 'foo 123)
    (check (hash-ref h 'foo) 123)
    (check (hash-ref h 'bar 404) 404)
    (hash-remove! h 'foo)
    (check (hash-ref h 'foo 'missing) 'missing)))

(test "Lambdas and Closures"
  (let ((add1 (lambda (x) (+ x 1))))
    (check (add1 5) 6))
  (let ((counter (let ((count 0)) (lambda () (set! count (+ count 1)) count))))
    (check (counter) 1)
    (check (counter) 2)))

(test "Metatables"
  (let ((h (make-hash))
        (mt (make-hash)))
    
    (hash-set! h 'val 10)
    (set-metatable! h mt)

    ;; Test :add operator
    (hash-set! mt :add (lambda (self other) 
                            (+ (hash-ref self 'val) other)))
    (check (+ h 5) 15)

    ;; Test :call
    (hash-set! mt :call (lambda (self . args)
                            (cons 'called args)))
    (check (h 1 2) '(called 1 2))
    
    ;; Remove :call to test :missing (otherwise :call takes precedence)
    (hash-remove! mt :call) 

    ;; Test :missing
    (hash-set! mt :missing (lambda (self key)
                               (list 'missing key)))
    (check (h 'unknown) '(missing (unknown)))))

(test "call/cc"
  (check (call/cc (lambda (k) (k 42))) 42)
  (check (+ 1 (call/cc (lambda (k) (+ 2 (k 3))))) 4)
  
  (let ((saved-k nil))
     (call/cc (lambda (k) (set! saved-k k)))
     (if saved-k
         (let ((k saved-k))
           (set! saved-k nil)
           (k 100))
         nil)
     (check t t)) )

(test "Exceptions"
  (check (try
           (error "oops")
           (catch e e))
         "oops")

  (check (try
            (throw 'my-error)
            (catch e e))
          'my-error)

  (check (try
           10
           (catch e 20))
         10)

  ;; finally
  (let ((side-effect 0))
    (try
      (throw 'err)
      (catch e nil)
      (finally (set! side-effect 1)))
    (check side-effect 1)))

;; Regression coverage for GC roots that only exist across a nested
;; eval_vm() re-entry (TRY/CATCH/FINALLY calling back into the
;; evaluator). (gc-start) followed by allocation would NOT catch these,
;; since gc_alloc() colors new objects BLACK (survives) while a cycle is
;; active - only an object allocated while IDLE and then swept by a
;; cycle forced mid-call is a real regression check. See docs/GC.md.

;; Recurses deeply enough (each call allocates via cons) to exceed the
;; GC's byte threshold and drive a full automatic mark+sweep cycle to
;; completion from *inside* a single catch-body call - the closure call
;; itself reassigns eval_vm's `env` away from catch_env for the whole
;; recursion, exactly the window that leaves catch_env unrooted.
(define (gc-rooting-churn n)
  (if (= n 0)
      0
      (begin (cons n n) (gc-rooting-churn (- n 1)))))

(test "GC rooting across nested eval"
  ;; The try-block's result lives in eval_vm's *result across the
  ;; FINALLY eval. Without rooting it, (gc) in finally sweeps the fresh
  ;; list (only reachable via that unrooted slot) before it's returned.
  (check (try
           (list 1 2 3)
           (finally (gc)))
         '(1 2 3))

  ;; catch's environment (binding the caught exception) is a fresh,
  ;; otherwise-unreachable env. Calling gc-rooting-churn as the first
  ;; body form reassigns env away from catch_env for the whole
  ;; recursion and allocates well past the GC threshold, so a full
  ;; automatic cycle completes while catch_env is unrooted; the second
  ;; form's lookup of `e` then depends on catch_env still being valid.
  (check (try
           (error "oops")
           (catch (e string?) (gc-rooting-churn 8000) e))
         "oops"))

;; Regression coverage for allocation-triggered GC stepping (docs/GC.md,
;; "Allocation-triggered stepping"): gc_alloc() now paces yas_gc_step()
;; itself, so a *single* builtin call that internally loops over many
;; yas_cons() calls without ever returning to eval_vm's loop (append's C
;; implementation, builtin_core.c) can now have a collection cycle
;; complete in the middle of it - something that could never happen
;; before this feature, since stepping only ran at eval_vm's own safe
;; point between forms. Unlike the "GC rooting across nested eval" test
;; above, this never calls (gc)/(gc-start) explicitly: the point is that
;; ordinary allocation alone, with no explicit trigger, is what advances
;; the collector now.
(define (make-numbered-list n)
  (let loop ((i 0) (acc nil))
    (if (= i n)
        acc
        (loop (+ i 1) (cons i acc)))))

(test "allocation-triggered stepping mid-builtin (append)"
  ;; Several thousand-element list arguments, appended in one call -
  ;; enough total conses for append()'s own internal accumulator to
  ;; plausibly span an automatic collection cycle.
  (define big-appended
    (append (make-numbered-list 3000)
            (make-numbered-list 3000)
            (make-numbered-list 3000)))
  (check (length big-appended) 9000)
  (check (car big-appended) 2999)
  (check (car (reverse big-appended)) 0))

(test "Docstrings"
  ;; Function with docstring
  (define (documented x) "This is documented" x)
  (check (procedure-doc documented) "This is documented")
  
  ;; Function without docstring  
  (define (undocumented x) x)
  (check (procedure-doc undocumented) nil)
  
  ;; Lambda with docstring
  (let ((f (lambda (x) "A lambda docstring" x)))
    (check (procedure-doc f) "A lambda docstring"))
  
  ;; Multi-expression body with docstring
  (define (multi-body a b)
    "Adds two numbers and prints result"
    (print a "+" b)
    (+ a b))
  (check (procedure-doc multi-body) "Adds two numbers and prints result"))

;; SIMD Vector/Matrix Tests
(test "SIMD Vectors"
  ;; Type predicates
  (check (vec2? #vec(1 2)) t)
  (check (vec3? #vec(1 2 3)) t)
  (check (vec4? #vec(1 2 3 4)) t)
  (check (mat4? (mat4-identity)) t)
  (check (vec2? #vec(1 2 3)) nil)
  (check (vec3? #vec(1 2)) nil)
  
  ;; Constructors
  (check (vec2? (vec2 1 2)) t)
  (check (vec3? (vec3 1 2 3)) t)
  (check (vec4? (vec4 1 2 3 4)) t)
  
  ;; Component accessors
  (check (vec-x #vec(10 20)) 10.0)
  (check (vec-y #vec(10 20)) 20.0)
  (check (vec-z #vec(1 2 3)) 3.0)
  (check (vec-w #vec(1 2 3 4)) 4.0)
  (check (vec-ref #vec(5 6 7) 1) 6.0)
  
  ;; Vector arithmetic
  (check (+ #vec(1 2) #vec(3 4)) #vec(4 6))
  (check (+ #vec(1 2 3) #vec(4 5 6)) #vec(5 7 9))
  (check (+ #vec(1 2) 10) #vec(11 12))
  (check (+ 10 #vec(1 2)) #vec(11 12)))

;; Hash literal syntax
(test "#hash Literal"
  (let ((h #hash(:name "test" :value 42)))
    (check (hash? h) t)
    (check (hash-ref h 'NAME) "test")
    (check (hash-ref h 'VALUE) 42)))

;; Additional Vector Arithmetic Tests
(test "Vector Subtraction"
  (check (- #vec(5 7) #vec(2 3)) #vec(3 4))
  (check (- #vec(10 20 30) 5) #vec(5 15 25)))

(test "Vector Multiplication"
  (check (* #vec(2 3) #vec(4 5)) #vec(8 15))
  (check (* #vec(1 2 3) 2) #vec(2 4 6))
  (check (* 3 #vec(2 2 2)) #vec(6 6 6)))

(test "Vector Division"
  (check (/ #vec(10 20) #vec(2 4)) #vec(5 5))
  (check (/ #vec(6 12 18) 3) #vec(2 4 6)))

(test "vec-set!"
  (let ((v (vec3 1 2 3)))
    (vec-set! v 1 99)
    (check (vec-y v) 99)))

(test "Matrix Operations"
  (let ((id (mat4-identity)))
    (check (mat4? id) t)
    (check (mat4? (mat4-transpose id)) t)
    (check (mat4? (mat4* id id)) t)
    (check (mat4? (mat4-inverse id)) t)))

;; Binary and Hex Literals
(test "Numeric Literals"
  (check 0xFF 255)
  (check 0b1010 10)
  (check 0x10 16)
  (check 0B11 3)
  (check 0XFF 255))

;; Loop Macros
(test "Loop Macros"
  (let ((sum 0))
    (dotimes (i 5) (set! sum (+ sum i)))
    (check sum 10))  ;; 0+1+2+3+4
  (let ((result nil))
    (dolist (x '(a b c)) (set! result (cons x result)))
    (check result '(c b a)))
  (let ((n 0))
    (while (< n 3) (set! n (+ n 1)))
    (check n 3)))

;; Serialization (from serialization_test.ys)
(test "Serialization"
  (check (serialize 123) "123")
  (check (serialize 3.5) "3.5") 
  (check (serialize "hello") "\"hello\"")
  (check (serialize :key) ":KEY")
  (check (serialize 'sym) "SYM")
  (check (serialize t) "T")
  (check (serialize nil) "nil")
  (check (serialize #(1 2)) "#(1 2)")
  (check (serialize '(1 2)) "#(1 2)"))

(test "Deserialization"
  (check (deserialize "123") 123)
  (check (deserialize "\"hello\"") "hello")
  (check (deserialize ":key") :KEY)
  (check (deserialize "#(1 2)") #(1 2))
  (let ((h (deserialize "(:k 1)")))
    (check (hash? h) t)
    (check (hash-ref h :k) 1)))

;; Keywords (from keyword_test.ys)
(test "Keywords"
  (check (keyword? :foo) t)
  (check (keyword? 'foo) nil)
  (check (keyword->string :hello) "HELLO")
  (check (string->keyword "world") :WORLD)
  (check (eq? :same :same) t)
  (check (eq? :foo :bar) nil))

;; UTF-8 (from utf8_test.ys)
(test "UTF-8 Characters"
  (check (char? #\a) t)
  (check (char? "a") nil)
  (check (char->integer #\a) 97)
  (check (char->integer #\newline) 10)
  (check (char=? #\a #\a) t)
  (check (char<? #\a #\b) t)
  (check (char=? (integer->char 65) #\A) t))

(test "UTF-8 Strings"
  (check (string-length "hello") 5)
  (check (string-length "日本語") 3)
  (check (string-length "λ") 1)
  (check (string-length "café") 4)
  (check (char=? (string-ref "hello" 0) #\h) t)
  (check (string-byte-length "hello") 5)
  (check (string-byte-length "日本語") 9)
  (check (string-byte-length "λ") 2))

;; Default Arguments (from default_args_test.ys)
(test "Default Arguments"
  (define (greet name (greeting "Hello"))
    (string-append greeting ", " name))
  (check (greet "World") "Hello, World")
  (check (greet "World" "Hi") "Hi, World"))

(test "Keyword Arguments"
  (define (make-point x y :color (color "black"))
    (list x y color))
  (check (make-point 10 20) '(10 20 "black"))
  (check (make-point 10 20 :color "red") '(10 20 "red")))

;; Format Function
(import (yas format))

(test "Format Strings"
  (check (format nil "Hello ~A!" "World") "Hello World!")
  (check (format nil "~D" 42) "42")
  (check (format nil "~X" 255) "FF")
  (check (format nil "~O" 64) "100")
  (check (format nil "~B" 10) "1010")
  (check (format nil "~~") "~")
  (check (format nil "~@D" 42) "+42")
  (check (format nil "~:D" 1000000) "1,000,000")
  (check (format nil "~R" 42) "forty-two")
  (check (format nil "~:R" 3) "third")
  (check (format nil "~@R" 1984) "MCMLXXXIV")
  (check (format nil "~D item~P" 1 1) "1 item")
  (check (format nil "~D item~P" 5 5) "5 items")
  (check (format nil "~A + ~A = ~A" 2 3 5) "2 + 3 = 5"))

(test "For Loop"
  (let ((sum 0))
    (for i from 1 to 6 do (set! sum (+ sum i)))
    (check sum 15))
  (let ((sum 0))
    (for i from 0 to 10 step 2 do (set! sum (+ sum i)))
    (check sum 20))
  (let ((acc nil))
    (for x in '(a b c) do (set! acc (cons x acc)))
    (check (reverse acc) '(a b c))))

(test "Symbol interning under growth"
  (define sym-growth-list (list 'SYM-0 'SYM-1 'SYM-2 'SYM-3 'SYM-4 'SYM-5
    'SYM-6 'SYM-7 'SYM-8 'SYM-9 'SYM-10 'SYM-11 'SYM-12 'SYM-13 'SYM-14
    'SYM-15 'SYM-16 'SYM-17 'SYM-18 'SYM-19 'SYM-20 'SYM-21 'SYM-22 'SYM-23
    'SYM-24 'SYM-25 'SYM-26 'SYM-27 'SYM-28 'SYM-29 'SYM-30 'SYM-31 'SYM-32
    'SYM-33 'SYM-34 'SYM-35 'SYM-36 'SYM-37 'SYM-38 'SYM-39 'SYM-40 'SYM-41
    'SYM-42 'SYM-43 'SYM-44 'SYM-45 'SYM-46 'SYM-47 'SYM-48 'SYM-49 'SYM-50
    'SYM-51 'SYM-52 'SYM-53 'SYM-54 'SYM-55 'SYM-56 'SYM-57 'SYM-58 'SYM-59
    'SYM-60 'SYM-61 'SYM-62 'SYM-63 'SYM-64 'SYM-65 'SYM-66 'SYM-67 'SYM-68
    'SYM-69 'SYM-70 'SYM-71 'SYM-72 'SYM-73 'SYM-74 'SYM-75 'SYM-76 'SYM-77
    'SYM-78 'SYM-79 'SYM-80 'SYM-81 'SYM-82 'SYM-83 'SYM-84 'SYM-85 'SYM-86
    'SYM-87 'SYM-88 'SYM-89 'SYM-90 'SYM-91 'SYM-92 'SYM-93 'SYM-94 'SYM-95
    'SYM-96 'SYM-97 'SYM-98 'SYM-99 'SYM-100 'SYM-101 'SYM-102 'SYM-103
    'SYM-104 'SYM-105 'SYM-106 'SYM-107 'SYM-108 'SYM-109 'SYM-110 'SYM-111
    'SYM-112 'SYM-113 'SYM-114 'SYM-115 'SYM-116 'SYM-117 'SYM-118 'SYM-119
    'SYM-120 'SYM-121 'SYM-122 'SYM-123 'SYM-124 'SYM-125 'SYM-126 'SYM-127
    'SYM-128 'SYM-129 'SYM-130 'SYM-131 'SYM-132 'SYM-133 'SYM-134 'SYM-135
    'SYM-136 'SYM-137 'SYM-138 'SYM-139 'SYM-140 'SYM-141 'SYM-142 'SYM-143
    'SYM-144 'SYM-145 'SYM-146 'SYM-147 'SYM-148 'SYM-149 'SYM-150 'SYM-151
    'SYM-152 'SYM-153 'SYM-154 'SYM-155 'SYM-156 'SYM-157 'SYM-158 'SYM-159
    'SYM-160 'SYM-161 'SYM-162 'SYM-163 'SYM-164 'SYM-165 'SYM-166 'SYM-167
    'SYM-168 'SYM-169 'SYM-170 'SYM-171 'SYM-172 'SYM-173 'SYM-174 'SYM-175
    'SYM-176 'SYM-177 'SYM-178 'SYM-179 'SYM-180 'SYM-181 'SYM-182 'SYM-183
    'SYM-184 'SYM-185 'SYM-186 'SYM-187 'SYM-188 'SYM-189 'SYM-190 'SYM-191
    'SYM-192 'SYM-193 'SYM-194 'SYM-195 'SYM-196 'SYM-197 'SYM-198 'SYM-199
    'SYM-200 'SYM-201 'SYM-202 'SYM-203 'SYM-204 'SYM-205 'SYM-206 'SYM-207
    'SYM-208 'SYM-209 'SYM-210 'SYM-211 'SYM-212 'SYM-213 'SYM-214 'SYM-215
    'SYM-216 'SYM-217 'SYM-218 'SYM-219 'SYM-220 'SYM-221 'SYM-222 'SYM-223
    'SYM-224 'SYM-225 'SYM-226 'SYM-227 'SYM-228 'SYM-229 'SYM-230 'SYM-231
    'SYM-232 'SYM-233 'SYM-234 'SYM-235 'SYM-236 'SYM-237 'SYM-238 'SYM-239
    'SYM-240 'SYM-241 'SYM-242 'SYM-243 'SYM-244 'SYM-245 'SYM-246 'SYM-247
    'SYM-248 'SYM-249 'SYM-250 'SYM-251 'SYM-252 'SYM-253 'SYM-254 'SYM-255
    'SYM-256 'SYM-257 'SYM-258 'SYM-259 'SYM-260 'SYM-261 'SYM-262 'SYM-263
    'SYM-264 'SYM-265 'SYM-266 'SYM-267 'SYM-268 'SYM-269 'SYM-270 'SYM-271
    'SYM-272 'SYM-273 'SYM-274 'SYM-275 'SYM-276 'SYM-277 'SYM-278 'SYM-279
    'SYM-280 'SYM-281 'SYM-282 'SYM-283 'SYM-284 'SYM-285 'SYM-286 'SYM-287
    'SYM-288 'SYM-289 'SYM-290 'SYM-291 'SYM-292 'SYM-293 'SYM-294 'SYM-295
    'SYM-296 'SYM-297 'SYM-298 'SYM-299))
  (check (length sym-growth-list) 300)
  ;; every symbol re-quoted here must be eq? to its first occurrence -
  ;; forces the intern table to grow (initial capacity 256, 300 distinct
  ;; symbols crosses the 70% rehash threshold) and checks identity survives
  (check (eq? (list-ref sym-growth-list 0) 'SYM-0) t)
  (check (eq? (list-ref sym-growth-list 150) 'SYM-150) t)
  (check (eq? (list-ref sym-growth-list 299) 'SYM-299) t)
  (check (eq? 'SYM-0 'SYM-0) t)
  (check (eq? 'SYM-1 'SYM-2) nil))

(test "Keyword interning under growth"
  (define kw-growth-list nil)
  (for i from 0 to 300 do
    (set! kw-growth-list (cons (string->keyword (string-append "KW-" (number->string i))) kw-growth-list)))
  (check (length kw-growth-list) 300)
  (check (eq? (string->keyword "KW-0") (string->keyword "KW-0")) t)
  (check (eq? (string->keyword "KW-150") (string->keyword "KW-150")) t)
  (check (eq? (string->keyword "KW-1") (string->keyword "KW-2")) nil))

(run-tests)
