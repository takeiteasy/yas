;; yas/base is imported automatically into every top-level env (main.c).
(import yas/math)
(import yas/hash)
(import yas/vector)
(import yas/text)
(import yas/test)

(print "Running YAS Test Suite...")

(test "Arithmetic"
  (check (+ 1 2) 3)
  (check (- 5 2) 3)
  (check (* 3 4) 12)
  (check (/ 10 2) 5)
  (check (modulo 10 3) 1))

;; Golden values for the libm-backed scalar math builtins (yas/math).
;; Float results go through exact equal?/=/comparison, so tolerances are
;; asserted as booleans.
(define (nan? x) (and (float? x) (not (= x x))))

(test "Math"
  ;; Inverse trig / logs
  (check (< (abs (- (asin 0.5) 0.5235987755982988)) 1.0e-12) t)
  (check (< (abs (- (acos 0.5) 1.0471975511965979)) 1.0e-12) t)
  (check (< (abs (- (atan 1) 0.7853981633974483)) 1.0e-12) t)
  (check (< (abs (- (atan2 1 1) 0.7853981633974483)) 1.0e-12) t)
  (check (< (abs (- (log (exp 1)) 1)) 1.0e-12) t)
  (check (< (abs (- (log2 8) 3)) 1.0e-12) t)
  (check (< (abs (- (log10 1000.0) 3)) 1.0e-12) t)
  (check (< (abs (- (sqrt 2) 1.4142135623730951)) 1.0e-12) t)
  (check (< (abs (- (pow 2 0.5) (sqrt 2))) 1.0e-12) t)
  ;; Trig round-trips
  (check (< (abs (- (sin 0) 0)) 1.0e-12) t)
  (check (< (abs (- (cos 0) 1)) 1.0e-12) t)
  (check (< (abs (+ (sin 1.234) (sin (- 1.234)))) 1.0e-12) t)
  (check (< (abs (- (* 2 (sin 0.617) (cos 0.617)) (sin 1.234))) 1.0e-12) t)
  (check (< (abs (- (tan 0.7853981633974483) 1)) 1.0e-12) t)
  ;; Rounding: integers stay integers, floats stay floats
  (check (floor 3) 3)
  (check (ceil 3) 3)
  (check (round 3) 3)
  (check (integer? (floor 3)) t)
  (check (floor 3.7) 3)
  (check (floor -3.2) -4)
  (check (ceil 3.2) 4)
  (check (ceil -3.7) -3)
  (check (round 3.5) 4)
  (check (round 2.4) 2)
  (check (round -2.5) -3)
  (check (float? (floor 3.7)) t)
  ;; IEEE domain results, not errors
  (check (< (log 0) -1.0e308) t)
  (check (< (log 0.0) -1.0e308) t)
  (check (nan? (asin 2)) t)
  (check (nan? (acos 2)) t)
  (check (nan? (sqrt -1)) t)
  (check (atan2 0 0) 0)
  (check (= (atan2 0 0) 0.0) t)
  ;; Argument/type errors still raise
  (check (try (asin) (catch e t)) t)
  (check (try (asin "x") (catch e t)) t)
  (check (try (atan2 1) (catch e t)) t))

(test "Lists"
  (check (car '(1 2)) 1)
  (check (cdr '(1 2)) '(2))
  (check (cons 1 2) '(1 . 2))
  (check (list 1 2 3) '(1 2 3))
  (check (append '(1) '(2)) '(1 2))
  (check (reverse '(1 2 3)) '(3 2 1)))

(test "Control Flow"
  (check (if t 1 2) 1)
  (check (if nil 1 2) 2)
  (check (cond (nil 1) (t 2)) 2)
  ;; when/unless return nil or result
  (check (when t 1) 1)
  (check (unless nil 1) 1))

(test "Vectors"
  (let ((v (make-vector 3 0)))
    (check (vector? v) t)
    (check (vector-length v) 3)
    (vector-set! v 0 10)
    (check (vector-ref v 0) 10)
    (check v #(10 0 0))))

(test "Hash Tables"
  (let ((h (make-hash)))
    (check (hash? h) t)
    (hash-set! h 'foo 123)
    (check (hash-ref h 'foo) 123)
    (check (hash-ref h 'bar 404) 404)
    (hash-remove! h 'foo)
    (check (hash-ref h 'foo 'missing) 'missing)))

(test "Lambdas and Closures"
  (let ((add1 (lambda (x) (+ x 1))))
    (check (add1 5) 6))
  (let ((counter (let ((count 0)) (lambda () (set! count (+ count 1)) count))))
    (check (counter) 1)
    (check (counter) 2)))

(test "Metatables"
  (let ((h (make-hash))
        (mt (make-hash)))
    
    (hash-set! h 'val 10)
    (set-metatable! h mt)

    ;; Test :add operator
    (hash-set! mt :add (lambda (self other) 
                            (+ (hash-ref self 'val) other)))
    (check (+ h 5) 15)

    ;; Test :call
    (hash-set! mt :call (lambda (self . args)
                            (cons 'called args)))
    (check (h 1 2) '(called 1 2))
    
    ;; Remove :call to test :missing (otherwise :call takes precedence)
    (hash-remove! mt :call) 

    ;; Test :missing
    (hash-set! mt :missing (lambda (self key)
                               (list 'missing key)))
    (check (h 'unknown) '(missing (unknown)))))

;; Regression (ticket #40): call/cc invoked as the *entire* top-level form,
;; with nothing pushed on the control stack below it, used to segfault -
;; capture popped to an empty stack, storing a NULL frame pointer, and
;; restore's `yas_nilp(*stack)` guard could never observe that (see
;; eval.c's CALL/CC capture/restore and docs/ARCHITECTURE.md#callcc).
;; This can only be exercised from a bare top-level form: wrapping it in
;; `test`/`check` (which expand through `begin` into a lambda application)
;; or in `define`/`if` pushes a frame *before* call/cc runs, so the
;; captured stack is never actually empty from inside them.
(define *callcc-empty-stack-result* nil)
(call/cc (lambda (k) (set! *callcc-empty-stack-result* 'reached) (k 1)))

;; Regression (ticket #58): continuations are snapshots. Each repro below
;; sits at TOP LEVEL deliberately - every top-level form starts with an
;; empty VM stack, so a captured chain bottoms out in its own form's
;; frames (the define/set!/if being computed) and a resumed invocation
;; converges instead of replaying enclosing test-runner continuations.
;; That replay is standard Scheme - an escaped continuation re-runs
;; whatever surrounded its capture point - which is exactly why these
;; can't live inside a `test` body.

;; Resume at the capture point even though the ordinary execution path
;; went on to finish (+ 100 1) = 101, popping both frames, long before
;; the continuation is invoked.
(define *k58-ret* nil)
(define *v58-ret* (+ 100 (call/cc (lambda (c) (set! *k58-ret* c) 1))))
(*k58-ret* 5)

;; Multi-shot determinism: three passes over one capture point, driven
;; from inside a single top-level call - an invocation resumes only the
;; captured chain (the frames live when call/cc ran), so the loop must
;; live within it; each invocation restarts identically regardless of
;; where previous resumed runs left their private frame clones.
(define *k58-multi* nil)
(define *multi58-log* nil)
(define (multi58-pass)
  (let ((v (call/cc (lambda (c) (set! *k58-multi* c) 0))))
    (set! *multi58-log* (cons v *multi58-log*))
    (if (< (length *multi58-log*) 3) (*k58-multi* (+ v 1)) nil)
    *multi58-log*))
(multi58-pass)

;; Captured mid-argument-evaluation: the snapshot freezes add3-58's
;; partially accumulated argument spine; the ordinary path then finishes
;; the call normally - which, before #58, reversed that very spine in
;; place under the snapshot's feet.
(define *k58-mid* nil)
(define (add3-58 a b c) (+ a (+ b c)))
(define *v58-mid* (add3-58 1 (call/cc (lambda (c) (set! *k58-mid* c) 2)) 3))
(*k58-mid* 20)

(test "call/cc"
  (check (call/cc (lambda (k) (k 42))) 42)
  (check (+ 1 (call/cc (lambda (k) (+ 2 (k 3))))) 4)

  (check *callcc-empty-stack-result* 'reached)

  ;; Ticket #58 outcome checks for the top-level repros above: each
  ;; resumed invocation recomputed its capture-point expression with the
  ;; supplied value, updating the binding the original form defined.
  (check *v58-ret* 105)             ; normal pass computed 101 first
  (check *multi58-log* '(2 1 0))    ; three identical restarts, newest first
  (check *v58-mid* 24)              ; normal pass computed 6 first

  ;; Escape + re-entry within one extent: invoking saved-k resumes right
  ;; after the call/cc that produced it, so the counter forms run once
  ;; more on the resumed clone before the let converges.
  (let ((saved-k nil) (n 0))
     (call/cc (lambda (k) (set! saved-k k)))
     (set! n (+ n 1))
     (if (> n 1) (set! saved-k nil) nil)
     (if saved-k (saved-k 'done) nil)
     (check n 2))

  ;; Multi-shot within one extent (docs/ARCHITECTURE.md#callcc): invoking
  ;; k2 re-enters just past its capture point, bumping invocations again;
  ;; a second invocation would do the same - nothing is consumed.
  (let ((k2 nil) (invocations 0))
    (call/cc (lambda (k) (set! k2 k)))
    (set! invocations (+ invocations 1))
    (if (= invocations 1) (k2 'again) nil)
    (check invocations 2))

  ;; A continuation captured inside a closure body outlives the call that
  ;; created it - the chain stays reachable through this binding for the
  ;; rest of the block, so GC must keep marking it (aux/
  ;; gc_continuation_stress.ys exercises invoking such a stashed chain
  ;; under forced collection). No invoke here on purpose: this capture
  ;; point sits inside the check above, and a later invocation would
  ;; replay that check with the resumed value (standard Scheme escape
  ;; semantics) - the top-level repros cover escape-and-invoke where the
  ;; replay converges.
  (define *escaped-k* nil)
  (define (capture-inside-closure)
    (+ 1 (call/cc (lambda (k) (set! *escaped-k* k) 0))))
  (check (capture-inside-closure) 1))

(test "Exceptions"
  (check (try
           (error "oops")
           (catch e e))
         "oops")

  (check (try
            (throw 'my-error)
            (catch e e))
          'my-error)

  (check (try
           10
           (catch e 20))
         10)

  ;; finally
  (let ((side-effect 0))
    (try
      (throw 'err)
      (catch e nil)
      (finally (set! side-effect 1)))
    (check side-effect 1)))

;; Regression coverage for GC roots that only exist across a nested
;; eval_vm() re-entry (TRY/CATCH/FINALLY calling back into the
;; evaluator). (gc-start) followed by allocation would NOT catch these,
;; since gc_alloc() colors new objects BLACK (survives) while a cycle is
;; active - only an object allocated while IDLE and then swept by a
;; cycle forced mid-call is a real regression check. See docs/GC.md.

;; Recurses deeply enough (each call allocates via cons) to exceed the
;; GC's byte threshold and drive a full automatic mark+sweep cycle to
;; completion from *inside* a single catch-body call - the closure call
;; itself reassigns eval_vm's `env` away from catch_env for the whole
;; recursion, exactly the window that leaves catch_env unrooted.
(define (gc-rooting-churn n)
  (if (= n 0)
      0
      (begin (cons n n) (gc-rooting-churn (- n 1)))))

(test "GC rooting across nested eval"
  ;; The try-block's result lives in eval_vm's *result across the
  ;; FINALLY eval. Without rooting it, (gc) in finally sweeps the fresh
  ;; list (only reachable via that unrooted slot) before it's returned.
  (check (try
           (list 1 2 3)
           (finally (gc)))
         '(1 2 3))

  ;; catch's environment (binding the caught exception) is a fresh,
  ;; otherwise-unreachable env. Calling gc-rooting-churn as the first
  ;; body form reassigns env away from catch_env for the whole
  ;; recursion and allocates well past the GC threshold, so a full
  ;; automatic cycle completes while catch_env is unrooted; the second
  ;; form's lookup of `e` then depends on catch_env still being valid.
  (check (try
           (error "oops")
           (catch (e string?) (gc-rooting-churn 8000) e))
         "oops"))

;; Regression coverage for allocation-triggered GC stepping (docs/GC.md,
;; "Allocation-triggered stepping"): gc_alloc() now paces yas_gc_step()
;; itself, so a *single* builtin call that internally loops over many
;; yas_cons() calls without ever returning to eval_vm's loop (append's C
;; implementation, builtin_core.c) can now have a collection cycle
;; complete in the middle of it - something that could never happen
;; before this feature, since stepping only ran at eval_vm's own safe
;; point between forms. Unlike the "GC rooting across nested eval" test
;; above, this never calls (gc)/(gc-start) explicitly: the point is that
;; ordinary allocation alone, with no explicit trigger, is what advances
;; the collector now.
(define (make-numbered-list n)
  (let loop ((i 0) (acc nil))
    (if (= i n)
        acc
        (loop (+ i 1) (cons i acc)))))

(test "allocation-triggered stepping mid-builtin (append)"
  ;; Several thousand-element list arguments, appended in one call -
  ;; enough total conses for append()'s own internal accumulator to
  ;; plausibly span an automatic collection cycle.
  (define big-appended
    (append (make-numbered-list 3000)
            (make-numbered-list 3000)
            (make-numbered-list 3000)))
  (check (length big-appended) 9000)
  (check (car big-appended) 2999)
  (check (car (reverse big-appended)) 0))

(test "Docstrings"
  ;; Function with docstring
  (define (documented x) "This is documented" x)
  (check (procedure-doc documented) "This is documented")
  
  ;; Function without docstring  
  (define (undocumented x) x)
  (check (procedure-doc undocumented) nil)
  
  ;; Lambda with docstring
  (let ((f (lambda (x) "A lambda docstring" x)))
    (check (procedure-doc f) "A lambda docstring"))
  
  ;; Multi-expression body with docstring
  (define (multi-body a b)
    "Adds two numbers and prints result"
    (print a "+" b)
    (+ a b))
  (check (procedure-doc multi-body) "Adds two numbers and prints result"))

;; SIMD Vector/Matrix Tests
(test "SIMD Vectors"
  ;; Type predicates
  (check (vec2? #vec(1 2)) t)
  (check (vec3? #vec(1 2 3)) t)
  (check (vec4? #vec(1 2 3 4)) t)
  (check (mat4? (mat4-identity)) t)
  (check (vec2? #vec(1 2 3)) nil)
  (check (vec3? #vec(1 2)) nil)
  
  ;; Constructors
  (check (vec2? (vec2 1 2)) t)
  (check (vec3? (vec3 1 2 3)) t)
  (check (vec4? (vec4 1 2 3 4)) t)
  
  ;; Component accessors
  (check (vec-x #vec(10 20)) 10.0)
  (check (vec-y #vec(10 20)) 20.0)
  (check (vec-z #vec(1 2 3)) 3.0)
  (check (vec-w #vec(1 2 3 4)) 4.0)
  (check (vec-ref #vec(5 6 7) 1) 6.0)
  
  ;; Vector arithmetic
  (check (+ #vec(1 2) #vec(3 4)) #vec(4 6))
  (check (+ #vec(1 2 3) #vec(4 5 6)) #vec(5 7 9))
  (check (+ #vec(1 2) 10) #vec(11 12))
  (check (+ 10 #vec(1 2)) #vec(11 12)))

;; Hash literal syntax
(test "#hash Literal"
  (let ((h #hash(:name "test" :value 42)))
    (check (hash? h) t)
    (check (hash-ref h 'NAME) "test")
    (check (hash-ref h 'VALUE) 42)))

;; Additional Vector Arithmetic Tests
(test "Vector Subtraction"
  (check (- #vec(5 7) #vec(2 3)) #vec(3 4))
  (check (- #vec(10 20 30) 5) #vec(5 15 25)))

(test "Vector Multiplication"
  (check (* #vec(2 3) #vec(4 5)) #vec(8 15))
  (check (* #vec(1 2 3) 2) #vec(2 4 6))
  (check (* 3 #vec(2 2 2)) #vec(6 6 6)))

(test "Vector Division"
  (check (/ #vec(10 20) #vec(2 4)) #vec(5 5))
  (check (/ #vec(6 12 18) 3) #vec(2 4 6)))

(test "vec-set!"
  (let ((v (vec3 1 2 3)))
    (vec-set! v 1 99)
    (check (vec-y v) 99)))

(test "Matrix Operations"
  (let ((id (mat4-identity)))
    (check (mat4? id) t)
    (check (mat4? (mat4-transpose id)) t)
    (check (mat4? (mat4* id id)) t)
    (check (mat4? (mat4-inverse id)) t)))

;; Binary and Hex Literals
(test "Numeric Literals"
  (check 0xFF 255)
  (check 0b1010 10)
  (check 0x10 16)
  (check 0B11 3)
  (check 0XFF 255))

;; Loop Macros
(test "Loop Macros"
  (let ((sum 0))
    (dotimes (i 5) (set! sum (+ sum i)))
    (check sum 10))  ;; 0+1+2+3+4
  (let ((result nil))
    (dolist (x '(a b c)) (set! result (cons x result)))
    (check result '(c b a)))
  (let ((n 0))
    (while (< n 3) (set! n (+ n 1)))
    (check n 3)))

;; Serialization (from serialization_test.ys)
(test "Serialization"
  (check (serialize 123) "123")
  (check (serialize 3.5) "3.5") 
  (check (serialize "hello") "\"hello\"")
  (check (serialize :key) ":KEY")
  (check (serialize 'sym) "SYM")
  (check (serialize t) "T")
  (check (serialize nil) "nil")
  (check (serialize #(1 2)) "#(1 2)")
  (check (serialize '(1 2)) "#(1 2)"))

(test "Deserialization"
  (check (deserialize "123") 123)
  (check (deserialize "\"hello\"") "hello")
  (check (deserialize ":key") :KEY)
  (check (deserialize "#(1 2)") #(1 2))
  (let ((h (deserialize "(:k 1)")))
    (check (hash? h) t)
    (check (hash-ref h :k) 1)))

;; Keywords (from keyword_test.ys)
(test "Keywords"
  (check (keyword? :foo) t)
  (check (keyword? 'foo) nil)
  (check (keyword->string :hello) "HELLO")
  (check (string->keyword "world") :WORLD)
  (check (eq? :same :same) t)
  (check (eq? :foo :bar) nil))

;; UTF-8 (from utf8_test.ys)
(test "UTF-8 Characters"
  (check (char? #\a) t)
  (check (char? "a") nil)
  (check (char->integer #\a) 97)
  (check (char->integer #\newline) 10)
  (check (char=? #\a #\a) t)
  (check (char<? #\a #\b) t)
  (check (char=? (integer->char 65) #\A) t))

(test "UTF-8 Strings"
  (check (string-length "hello") 5)
  (check (string-length "日本語") 3)
  (check (string-length "λ") 1)
  (check (string-length "café") 4)
  (check (char=? (string-ref "hello" 0) #\h) t)
  (check (string-byte-length "hello") 5)
  (check (string-byte-length "日本語") 9)
  (check (string-byte-length "λ") 2))

;; Default Arguments (from default_args_test.ys)
(test "Default Arguments"
  (define (greet name (greeting "Hello"))
    (string-append greeting ", " name))
  (check (greet "World") "Hello, World")
  (check (greet "World" "Hi") "Hi, World"))

(test "Keyword Arguments"
  (define (make-point x y :color (color "black"))
    (list x y color))
  (check (make-point 10 20) '(10 20 "black"))
  (check (make-point 10 20 :color "red") '(10 20 "red")))

;; Keyword binding must never mutate an unowned argument spine (#66):
;; a macro call site binds the source form's own arg spine (the #64
;; expansion-memo key), MACROEXPAND-1 binds the cdr of arbitrary
;; evaluated data, and APPLY binds the caller's raw argument list -
;; eval_do_bind() takes one private copy before splicing matched
;; :keyword/value pairs out.
(test "Keyword Args Do Not Mutate Caller Lists"
  (define (kw-fn :a x :b y) (list x y))
  (define lst (list :b 2 :a 1))
  (check (apply kw-fn lst) '(1 2))
  (check lst '(:B 2 :A 1))
  (defmacro (kw-mac :a x :b y) (list (quote quote) (list x y)))
  (define form (quote (kw-mac :b 2 :a 1)))
  (check (macroexpand-1 form) (quote (quote (1 2))))
  (check form (quote (kw-mac :B 2 :A 1)))
  (check (kw-mac :b 2 :a 1) (quote (1 2)))
  (check (kw-mac :b 2 :a 1) (quote (1 2))))

;; Format Function
(import yas/format)

(test "Format Strings"
  (check (format nil "Hello ~A!" "World") "Hello World!")
  (check (format nil "~D" 42) "42")
  (check (format nil "~X" 255) "FF")
  (check (format nil "~O" 64) "100")
  (check (format nil "~B" 10) "1010")
  (check (format nil "~~") "~")
  (check (format nil "~@D" 42) "+42")
  (check (format nil "~:D" 1000000) "1,000,000")
  (check (format nil "~R" 42) "forty-two")
  (check (format nil "~:R" 3) "third")
  (check (format nil "~@R" 1984) "MCMLXXXIV")
  (check (format nil "~D item~P" 1 1) "1 item")
  (check (format nil "~D item~P" 5 5) "5 items")
  (check (format nil "~A + ~A = ~A" 2 3 5) "2 + 3 = 5"))

(test "For Loop"
  (let ((sum 0))
    (for i from 1 to 6 do (set! sum (+ sum i)))
    (check sum 15))
  (let ((sum 0))
    (for i from 0 to 10 step 2 do (set! sum (+ sum i)))
    (check sum 20))
  (let ((acc nil))
    (for x in '(a b c) do (set! acc (cons x acc)))
    (check (reverse acc) '(a b c))))

(test "Symbol interning under growth"
  (define sym-growth-list (list 'SYM-0 'SYM-1 'SYM-2 'SYM-3 'SYM-4 'SYM-5
    'SYM-6 'SYM-7 'SYM-8 'SYM-9 'SYM-10 'SYM-11 'SYM-12 'SYM-13 'SYM-14
    'SYM-15 'SYM-16 'SYM-17 'SYM-18 'SYM-19 'SYM-20 'SYM-21 'SYM-22 'SYM-23
    'SYM-24 'SYM-25 'SYM-26 'SYM-27 'SYM-28 'SYM-29 'SYM-30 'SYM-31 'SYM-32
    'SYM-33 'SYM-34 'SYM-35 'SYM-36 'SYM-37 'SYM-38 'SYM-39 'SYM-40 'SYM-41
    'SYM-42 'SYM-43 'SYM-44 'SYM-45 'SYM-46 'SYM-47 'SYM-48 'SYM-49 'SYM-50
    'SYM-51 'SYM-52 'SYM-53 'SYM-54 'SYM-55 'SYM-56 'SYM-57 'SYM-58 'SYM-59
    'SYM-60 'SYM-61 'SYM-62 'SYM-63 'SYM-64 'SYM-65 'SYM-66 'SYM-67 'SYM-68
    'SYM-69 'SYM-70 'SYM-71 'SYM-72 'SYM-73 'SYM-74 'SYM-75 'SYM-76 'SYM-77
    'SYM-78 'SYM-79 'SYM-80 'SYM-81 'SYM-82 'SYM-83 'SYM-84 'SYM-85 'SYM-86
    'SYM-87 'SYM-88 'SYM-89 'SYM-90 'SYM-91 'SYM-92 'SYM-93 'SYM-94 'SYM-95
    'SYM-96 'SYM-97 'SYM-98 'SYM-99 'SYM-100 'SYM-101 'SYM-102 'SYM-103
    'SYM-104 'SYM-105 'SYM-106 'SYM-107 'SYM-108 'SYM-109 'SYM-110 'SYM-111
    'SYM-112 'SYM-113 'SYM-114 'SYM-115 'SYM-116 'SYM-117 'SYM-118 'SYM-119
    'SYM-120 'SYM-121 'SYM-122 'SYM-123 'SYM-124 'SYM-125 'SYM-126 'SYM-127
    'SYM-128 'SYM-129 'SYM-130 'SYM-131 'SYM-132 'SYM-133 'SYM-134 'SYM-135
    'SYM-136 'SYM-137 'SYM-138 'SYM-139 'SYM-140 'SYM-141 'SYM-142 'SYM-143
    'SYM-144 'SYM-145 'SYM-146 'SYM-147 'SYM-148 'SYM-149 'SYM-150 'SYM-151
    'SYM-152 'SYM-153 'SYM-154 'SYM-155 'SYM-156 'SYM-157 'SYM-158 'SYM-159
    'SYM-160 'SYM-161 'SYM-162 'SYM-163 'SYM-164 'SYM-165 'SYM-166 'SYM-167
    'SYM-168 'SYM-169 'SYM-170 'SYM-171 'SYM-172 'SYM-173 'SYM-174 'SYM-175
    'SYM-176 'SYM-177 'SYM-178 'SYM-179 'SYM-180 'SYM-181 'SYM-182 'SYM-183
    'SYM-184 'SYM-185 'SYM-186 'SYM-187 'SYM-188 'SYM-189 'SYM-190 'SYM-191
    'SYM-192 'SYM-193 'SYM-194 'SYM-195 'SYM-196 'SYM-197 'SYM-198 'SYM-199
    'SYM-200 'SYM-201 'SYM-202 'SYM-203 'SYM-204 'SYM-205 'SYM-206 'SYM-207
    'SYM-208 'SYM-209 'SYM-210 'SYM-211 'SYM-212 'SYM-213 'SYM-214 'SYM-215
    'SYM-216 'SYM-217 'SYM-218 'SYM-219 'SYM-220 'SYM-221 'SYM-222 'SYM-223
    'SYM-224 'SYM-225 'SYM-226 'SYM-227 'SYM-228 'SYM-229 'SYM-230 'SYM-231
    'SYM-232 'SYM-233 'SYM-234 'SYM-235 'SYM-236 'SYM-237 'SYM-238 'SYM-239
    'SYM-240 'SYM-241 'SYM-242 'SYM-243 'SYM-244 'SYM-245 'SYM-246 'SYM-247
    'SYM-248 'SYM-249 'SYM-250 'SYM-251 'SYM-252 'SYM-253 'SYM-254 'SYM-255
    'SYM-256 'SYM-257 'SYM-258 'SYM-259 'SYM-260 'SYM-261 'SYM-262 'SYM-263
    'SYM-264 'SYM-265 'SYM-266 'SYM-267 'SYM-268 'SYM-269 'SYM-270 'SYM-271
    'SYM-272 'SYM-273 'SYM-274 'SYM-275 'SYM-276 'SYM-277 'SYM-278 'SYM-279
    'SYM-280 'SYM-281 'SYM-282 'SYM-283 'SYM-284 'SYM-285 'SYM-286 'SYM-287
    'SYM-288 'SYM-289 'SYM-290 'SYM-291 'SYM-292 'SYM-293 'SYM-294 'SYM-295
    'SYM-296 'SYM-297 'SYM-298 'SYM-299))
  (check (length sym-growth-list) 300)
  ;; every symbol re-quoted here must be eq? to its first occurrence -
  ;; forces the intern table to grow (initial capacity 256, 300 distinct
  ;; symbols crosses the 70% rehash threshold) and checks identity survives
  (check (eq? (list-ref sym-growth-list 0) 'SYM-0) t)
  (check (eq? (list-ref sym-growth-list 150) 'SYM-150) t)
  (check (eq? (list-ref sym-growth-list 299) 'SYM-299) t)
  (check (eq? 'SYM-0 'SYM-0) t)
  (check (eq? 'SYM-1 'SYM-2) nil))

(test "Keyword interning under growth"
  (define kw-growth-list nil)
  (for i from 0 to 300 do
    (set! kw-growth-list (cons (string->keyword (string-append "KW-" (number->string i))) kw-growth-list)))
  (check (length kw-growth-list) 300)
  (check (eq? (string->keyword "KW-0") (string->keyword "KW-0")) t)
  (check (eq? (string->keyword "KW-150") (string->keyword "KW-150")) t)
  (check (eq? (string->keyword "KW-1") (string->keyword "KW-2")) nil))

(test "Hash growth and mixed key types"
  (let ((h (make-hash)))
    (for i from 0 to 300 do
      (hash-set! h i (* i i)))
    (check (hash-length h) 300)
    (check (hash-ref h 0) 0)
    (check (hash-ref h 150) 22500)
    (check (hash-ref h 299) 89401)
    (hash-remove! h 150)
    (check (hash-ref h 150 'missing) 'missing)
    (check (hash-length h) 299)
    (hash-set! h 150 22500)
    (check (hash-ref h 150) 22500)
    (check (hash-length h) 300))
  (let ((h (make-hash)))
    (hash-set! h 'sym-key "symbol")
    (hash-set! h :kw-key "keyword")
    (hash-set! h "str-key" "string")
    (hash-set! h 42 "integer")
    (hash-set! h 3.5 "float")
    (check (hash-ref h 'sym-key) "symbol")
    (check (hash-ref h :kw-key) "keyword")
    (check (hash-ref h "str-key") "string")
    (check (hash-ref h 42) "integer")
    (check (hash-ref h 3.5) "float")
    ;; two distinct string allocations with equal content must hit the
    ;; same slot - atom_hash() must hash string content (FNV-1a), not
    ;; the string atom's pointer
    (check (hash-ref h (string-append "str-" "key")) "string")))

(test "current-time"
  ;; Monotonic wall clock (docs/BENCHMARKING.md, aux/bench_*.ys) - only
  ;; relative differences are meaningful, not the epoch. `>=` not `>`: two
  ;; calls can land in the same tick.
  (check (float? (current-time)) t)
  (let ((a (current-time))
        (b (current-time)))
    (check (>= b a) t)))

;; Root-frame lookup cache (ticket #45, data.c's yas_env_get()/
;; yas_env_set()): a symbol never yas_env_define()'d into a non-root
;; frame caches (root env, slot) behind its interned pointer and skips
;; the parent-chain walk entirely. These are the scenarios where the
;; design could produce a silently wrong value rather than a crash -
;; see docs/ARCHITECTURE.md's "Environments" section.

(define lex-global 100)

(test "Lexical cache: global read through nested frames"
  ;; Force several env frames between the lookup site and the root, and
  ;; call twice so the second call hits the now-warm cache - a bug that
  ;; only walks one hop, or that only works cold, would show up here.
  (check ((let ((a 1)) (let ((b 2)) (lambda () lex-global)))) lex-global)
  (check ((let ((a 1)) (let ((b 2)) (lambda () lex-global)))) 100))

(test "Lexical cache: parameter shadows, then unshadows"
  ;; Read the global first (warms the root-frame cache while unshadowed),
  ;; then call a lambda whose parameter shares the name - its body must
  ;; see the parameter, not the cached global - then read the bare global
  ;; again afterwards to confirm the outer binding was never disturbed.
  (check lex-global 100)
  (check ((lambda (lex-global) lex-global) 999) 999)
  (check lex-global 100)
  ;; and the reverse order: shadow first, cache second
  (check ((lambda (lex-global) lex-global) 999) 999)
  (check lex-global 100))

(test "Lexical cache: set! on a global from a nested closure"
  (define lex-counter 0)
  (define (bump) (set! lex-counter (+ lex-counter 1)))
  (let ((x 1)) (let ((y 2)) (bump)))
  (check lex-counter 1))

(test "Lexical cache: set! with a warm cache, then shadowed"
  ;; The one scenario that would be a silent wrong-value bug rather than
  ;; a crash: read `lex-shadow-target` at top level (populating the
  ;; root-frame cache while unshadowed), then call a lambda that binds
  ;; the same name as a parameter and set!s it - the write must land on
  ;; the parameter, not the cached global slot.
  (define lex-shadow-target 5)
  (check lex-shadow-target 5) ;; warms the cache
  (check ((lambda (lex-shadow-target)
            (set! lex-shadow-target 999)
            lex-shadow-target)
          5)
         999)
  (check lex-shadow-target 5)) ;; global must be untouched

(test "Lexical cache: internal define shadows without corrupting outer"
  (define lex-inner-target 7)
  (define (lex-inner-shadow)
    (define lex-inner-target 42)
    lex-inner-target)
  (check (lex-inner-shadow) 42)
  (check lex-inner-target 7))

(test "Lexical cache: redefine a global after it has been cached"
  (define lex-redef 1)
  (check lex-redef 1) ;; warms the cache
  (define lex-redef 2) ;; overwrite-in-place, same root slot
  (check lex-redef 2))

;; Warm the cache for a global, then define enough fresh top-level
;; globals (no eval/string->symbol in this build, so these are spelled
;; out literally) to cross the 70% load factor and force env_grow() to
;; rehash every slot in the script's root frame, moving lex-grow-target's
;; - the cache must self-validate against the live table and re-probe
;; rather than reading a stale/wrong slot after the move.
(define lex-grow-target 'before-grow)
(test "Lexical cache: survives env_grow rehash (before filler defines)"
  (check lex-grow-target 'before-grow)) ;; warms the cache

(define lex-grow-filler-00 0) (define lex-grow-filler-01 1)
(define lex-grow-filler-02 2) (define lex-grow-filler-03 3)
(define lex-grow-filler-04 4) (define lex-grow-filler-05 5)
(define lex-grow-filler-06 6) (define lex-grow-filler-07 7)
(define lex-grow-filler-08 8) (define lex-grow-filler-09 9)
(define lex-grow-filler-10 10) (define lex-grow-filler-11 11)
(define lex-grow-filler-12 12) (define lex-grow-filler-13 13)
(define lex-grow-filler-14 14) (define lex-grow-filler-15 15)
(define lex-grow-filler-16 16) (define lex-grow-filler-17 17)
(define lex-grow-filler-18 18) (define lex-grow-filler-19 19)
(define lex-grow-filler-20 20) (define lex-grow-filler-21 21)
(define lex-grow-filler-22 22) (define lex-grow-filler-23 23)
(define lex-grow-filler-24 24) (define lex-grow-filler-25 25)
(define lex-grow-filler-26 26) (define lex-grow-filler-27 27)
(define lex-grow-filler-28 28) (define lex-grow-filler-29 29)
(define lex-grow-filler-30 30) (define lex-grow-filler-31 31)
(define lex-grow-filler-32 32) (define lex-grow-filler-33 33)
(define lex-grow-filler-34 34) (define lex-grow-filler-35 35)
(define lex-grow-filler-36 36) (define lex-grow-filler-37 37)
(define lex-grow-filler-38 38) (define lex-grow-filler-39 39)

(test "Lexical cache: survives env_grow rehash (after filler defines)"
  (check lex-grow-target 'before-grow)
  (check lex-grow-filler-39 39))

(test "Lexical cache: unbound symbol still errors"
  ;; The `!shadowed` fast path's early UNBOUND return (data.c) is a new
  ;; code path to the existing error - make sure it still reports it.
  ;; (the exception's `type-error` tag is built via yas_make_sym() in C,
  ;; not read from source, so it stays lowercase - CLAUDE.md's "reader
  ;; uppercases every symbol" doesn't apply to it - check the message
  ;; text instead of the whole list.)
  (check (car (cdr (try
                      lex-totally-unbound-symbol
                      (catch e e))))
         "Symbol not bound: LEX-TOTALLY-UNBOUND-SYMBOL"))

(test "Lexical cache: module-imported global still resolves"
  ;; yas/base rebinds +/-/*// to variadic closures (CLAUDE.md) - make
  ;; sure the cache resolves to the module's binding, not some earlier
  ;; native builtin slot.
  (check (+ 1 2 3) 6)
  (check (let ((a 1)) (let ((b 2)) (+ 1 2 3))) 6))

;; #63 removed the up-front yas_listp(expr) walk that used to reject an
;; improper call/special-form spine before anything else happened -
;; properness is now checked incrementally, at each site that actually
;; consumes another cell (see eval.c's "Evaluator" comment and
;; docs/ARCHITECTURE.md). These pin the new behaviour: an improper form
;; still always errors and is still caught by TRY/CATCH. (Checking only
;; that the catch fires, not the exact message - the exact message for
;; code-only failures is pinned separately below, since the exception a
;; handler receives is now always its own failure's.)
(test "Improper forms: call/special-form spine still errors (#63)"
  (check (try (1 . 2) (catch e 'caught)) 'caught)
  (check (try (if 1 . 2) (catch e 'caught)) 'caught)
  (check (try (+ 1 . 2) (catch e 'caught)) 'caught)
  (check (try ((lambda (x) x) . 5) (catch e 'caught)) 'caught)
  (check (try (lambda (x) . 5) (catch e 'caught)) 'caught)
  (check (try (defmacro (bad-macro x) . 5) (catch e 'caught)) 'caught))

(test "Improper forms: ordinary evaluation is unaffected (#63)"
  ;; Same shapes as above, but proper - nothing here should have changed.
  (check (+ 1 2 3) 6)
  (check (if 1 'yes 'no) 'yes)
  (check ((lambda (x) x) 5) 5)
  (check ((lambda (x) (+ x 1)) 5) 6))

;; #65: yas_ctx_exception used to survive a caught error, so a later
;; handler whose own failure produced no explicit exception object
;; (code-only SYNTAX/ARGS/TYPE failures) was handed the earlier catch's
;; stale value. A matched CATCH clause now clears the global once it has
;; bound the value into its own environment. The ticket's repro: an
;; unbound-symbol catch followed by a syntax-error catch.
(test "Exceptions: a handled exception never leaks into later catches (#65)"
  ;; First block installs the rich exception object... (compare the
  ;; message text only: the `type-error` tag is built via yas_make_sym()
  ;; in C and stays lowercase - see the lexical-cache unbound-symbol test
  ;; above for why a quoted list can't match it.)
  (check (car (cdr (try lex-totally-unbound-symbol (catch e e))))
         "Symbol not bound: LEX-TOTALLY-UNBOUND-SYMBOL")
  ;; ...the second must describe its OWN failure, not inherit the first.
  (check (try (1 . 2) (catch e e)) "Syntax error")
  ;; Same with a happy-path try in between.
  (check (try 42 (catch e 'nope)) 42)
  (check (try (+ 1 . 2) (catch e e)) "Syntax error")
  ;; An explicit raise is still delivered verbatim, every time.
  (check (try (error "boom") (catch e e)) "boom")
  (check (try (throw 'fresh) (catch e e)) 'FRESH))

(test "Exceptions: predicate decline keeps the value for later clauses (#65)"
  ;; Clearing happens only when a clause MATCHES - a declined predicate
  ;; must leave the pending exception intact for the next clause.
  (check (try (throw 'a)
            (catch (e (lambda (x) nil)) 'declined)
            (catch (e (lambda (x) (eq? x 'a))) 'a-branch))
         'A-BRANCH)
  (check (try (throw 'b)
            (catch (e (lambda (x) (eq? x 'a))) 'a-branch)
            (catch (e (lambda (x) (eq? x 'b))) 'b-branch))
         'B-BRANCH))

(test "Exceptions: uncaught errors still carry their object outward (#65)"
  ;; The complement of the fix - clearing is consumption, so an uncaught
  ;; throw crossing nested TRY boundaries must stay intact.
  (check (try (try (throw 'deep)) (catch e e)) 'DEEP))

(test "Exceptions: errors from inside a catch body replace cleanly (#65)"
  ;; A body that raises its own explicit exception delivers that one...
  (check (try (try (throw 'first) (catch e (throw 'second))) (catch e e))
         'SECOND)
  ;; ...and a body failing with a code-only error surfaces ITS message,
  ;; where pre-#65 the outer catch saw the inner consumed exception.
  (check (try (try (throw 'first) (catch e (1 . 2))) (catch e e))
         "Syntax error"))

(test "Exceptions: malformed catch clause reports itself, not the pending value (#65)"
  ;; The clause below has var_decl = ((e) ...) - a list, not a symbol or
  ;; (sym pred) pair. Delivery of the thrown 'x failed structurally, so
  ;; the outward error describes the malformation instead of carrying 'x.
  (check (try (try (throw 'x) (catch ((e) 'bad))) (catch e e))
         "Type error"))

;; #69: a CATCH predicate that fails used to drag the dispatched value
;; outward behind its own error - the outer handler received the inner
;; throw's stale value instead of anything describing the pred's failure.
;; The evaluator now dispatches from a detached snapshot and only restores
;; it on unhandled passthrough, so whatever happens inside the pred owns
;; the exception state exclusively.
(test "Exceptions: predicate failures report themselves, not the dispatched value (#69)"
  ;; Code-only pred failure: ((IF) E) trips IF's arity check, nothing
  ;; raises explicitly - the outer catch must see the ARGS message.
  (check (try (try (throw 'x) (catch (e (if)) 'never)) (catch e e))
         "Argument error")
  ;; Explicit raise inside the pred replaces the value outright - the
  ;; unbound-symbol path installs its own fresh object. (Message text
  ;; only: the `type-error` tag is C-built and stays lowercase, so a
  ;; quoted list can't match it.)
  (check (car (cdr (try (try (throw 'x) (catch (e nope-unbound-sym) 'never)) (catch e e))))
         "Symbol not bound: NOPE-UNBOUND-SYM")
  ;; A pred rethrowing the caught value still delivers it - the rethrow is
  ;; a legitimate raise, not staleness.
  (check (try (try (throw 'x) (catch (e (throw e)) 'never)) (catch e e))
         'X)
  ;; Declined preds keep the value alive for later clauses (unchanged by
  ;; #69, pinned here because the mechanism moved out from under them).
  (check (try (throw 'a)
            (catch (e (lambda (x) nil)) 'declined)
            (catch (e (lambda (x) (eq? x 'a))) 'a-branch))
         'A-BRANCH))

;; #64: a macro call site now caches its expansion instead of re-running
;; the macro's closure on every evaluation. Pin correctness for exactly
;; the case this targets - the same source call site evaluated many
;; times inside a loop body - since `when`/`dotimes` are themselves
;; `defmacro`s (std/yas/base.ys) whose own control-flow skeleton is now
;; also cached per call site.
(define memo-sum 0)
(dotimes (memo-i 20)
  (when (> memo-i 10)
    (set! memo-sum (+ memo-sum memo-i))))
(test "Macro memo: loop-body macro call sites stay correct across iterations (#64)"
  (check memo-sum (+ 11 12 13 14 15 16 17 18 19)))

;; Redefining a macro used inside an already-defined function must be
;; picked up on the function's next call - the memo is keyed on the
;; macro binding's identity (compared by the closure cons's own pointer,
;; not by name), and `defmacro` allocates a fresh closure, so a
;; redefinition naturally misses the old entry rather than needing an
;; explicit invalidation step. The three steps (define, warm the cache,
;; redefine) are deliberately kept at top level rather than inside
;; `test`'s body: `test`/`begin` expand through a `(lambda () ...)`
;; (std/yas/base.ys), so a `defmacro` nested in there would define a
;; *local* shadow in that lambda's own frame rather than updating the
;; global binding `memo-redef-caller`'s closure (captured over the outer/
;; global env before the shadow exists) actually looks up - unrelated to
;; #64, just how `define`/`defmacro` scoping already works.
(defmacro (memo-redef-macro x) (list '+ x 1))
(define (memo-redef-caller y) (memo-redef-macro y))
(memo-redef-caller 10) ;; warms the cache for this call site
(memo-redef-caller 10) ;; still cached
(defmacro (memo-redef-macro x) (list '+ x 100))
(test "Macro memo: redefining a macro invalidates its cached call sites (#64)"
  (check (memo-redef-caller 10) 110))

(run-tests)
