(import (gold base) (gold text))

(print "Testing default arguments:")

;; Optional positional with default
(define (greet name (greeting "Hello"))
  (string-append greeting ", " name))

(print "greet 'World' =>" (greet "World"))
(print "greet 'World' 'Hi' =>" (greet "World" "Hi"))

;; Keyword arguments
(define (make-point x y :color (color "black"))
  (list x y color))

(print "make-point 10 20 =>" (make-point 10 20))
(print "make-point 10 20 :color 'red' =>" (make-point 10 20 :color "red"))

;; Multiple keywords
(define (configure :host (host "localhost") :port (port 8080))
  (list host port))

(print "configure =>" (configure))
(print "configure :port 3000 =>" (configure :port 3000))
(print "configure :host 'example.com' :port 443 =>" (configure :host "example.com" :port 443))

(print "Done!")
