;; Comprehensive test of (gold io) library
(import (gold io))

(print "===== Testing (gold io) Library =====")

;; Test call-with-input-file
(print "\n1. call-with-input-file:")
(define first-line (call-with-input-file "Makefile" read-line))
(print first-line)

;; Test call-with-output-file
(print "\n2. call-with-output-file:")
(call-with-output-file "t/test-output.txt"
  (lambda (port)
    (write-string "Written via call-with-output-file" port)
    (newline port)
    (write-string "Line 2" port)))
(print "File written successfully")

;; Test read-file
(print "\n3. read-file:")
(print (read-file "t/test-output.txt"))

;; Test write-file
(print "\n4. write-file:")
(write-file "t/test-output2.txt" "Hello via write-file!\nSecond line!")
(print (read-file "t/test-output2.txt"))

;; Test file-exists?
(print "\n5. file-exists?:")
(print (file-exists? "t/test-output.txt"))
(print (file-exists? "nonexistent.xyz"))

;; Test bytevector operations
(print "\n6. Bytevector operations:")
(define bv (make-bytevector 5 65))
(print (bytevector? bv))
(print (bytevector-length bv))
(print (bytevector-u8-ref bv 0))
(bytevector-u8-set! bv 0 66)
(print (bytevector->string bv))

;; Test sandbox
(print "\n7. Sandbox mode:")
(print (io-sandbox-mode))

(print "\n===== All Tests Passed! =====")
