;; Test I/O sandbox
(import (gold primitives))

;; Test sandbox mode - should be unrestricted by default
(print "Default sandbox mode:")
(print (io-sandbox-mode))

;; Test file-exists?
(print "\nFile exists test:")
(print (file-exists? "Makefile"))

;; Test reading
(print "\nReading first line of Makefile:")
(define port (open-input-file "Makefile"))
(print (read-line port))
(close-port port)

;; Test writing
(print "\nWriting to /tmp/gold-io-test.txt:")
(define out (open-output-file "/tmp/gold-io-test.txt"))
(write-string "Hello from Gold!" out)
(newline out)
(close-port out)
(print "Done!")

;; Read it back
(print "\nReading back:")
(define in (open-input-file "/tmp/gold-io-test.txt"))
(print (read-all in))
(close-port in)

;; Test bytevector
(print "\nBytevector test:")
(define bv (make-bytevector 5 65))
(print (bytevector? bv))
(print (bytevector-length bv))
(print (bytevector-u8-ref bv 0))
(print (bytevector->string bv))

;; Test sandbox configuration
(print "\nSandbox config test:")
(io-sandbox-mode 'restricted-deny)
(print (io-sandbox-mode))
(io-sandbox-allow! "/tmp/*")

;; This should work
(print "\nOpening allowed path:")
(define ok-port (open-output-file "/tmp/sandbox-ok.txt"))
(print ok-port)
(close-port ok-port)

(print "\nAll tests complete!")
