(import (gold primitives))
(print "Testing keyword type:")
(print :foo)
(print "keyword? :foo =>" (keyword? :foo))
(print "keyword? 'foo =>" (keyword? 'foo))
(print "keyword->string :hello =>" (keyword->string :hello))
(print "string->keyword \"world\" =>" (string->keyword "world"))
(print "eq? :same :same =>" (eq? :same :same))
(print "eq? :foo :bar =>" (eq? :foo :bar))
(print "Done!")
