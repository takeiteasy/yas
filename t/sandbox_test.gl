;; Test new combined RESTRICTED sandbox mode
(import (gold primitives))

(print "===== Sandbox Mode Tests =====")

;; Check default mode
(print "\n1. Default mode:")
(print (io-sandbox-mode))

;; Test RESTRICTED with allow-by-default (like old blacklist)
(print "\n2. RESTRICTED-ALLOW mode (deny specific paths):")
(io-sandbox-mode 'restricted-allow)
(print (io-sandbox-mode))

;; Deny "/etc/*" but allow everything else
(io-sandbox-deny! "/etc/*")
(print "Denied /etc/*")

;; This should work (not denied)
(print "Opening Makefile (should work):")
(print (file-exists? "Makefile"))

;; Test RESTRICTED with deny-by-default (like old whitelist)  
(print "\n3. RESTRICTED-DENY mode (allow specific paths):")
(io-sandbox-mode 'restricted-deny)
(print (io-sandbox-mode))

;; Allow only t/*
(io-sandbox-allow! "t/*")
(print "Allowed t/*")

;; This should fail (not in allow list)
(print "Checking Makefile (should fail - not allowed):")
(print (file-exists? "Makefile"))

;; This should work (explicitly allowed)
(print "Checking t/test.gl (should work - allowed):")
(print (file-exists? "t/test.gl"))

;; Test combined allow + deny
(print "\n4. Combined allow/deny (allow overrides deny):")
(io-sandbox-mode 'restricted-deny)
(io-sandbox-allow! "*.gl")
(io-sandbox-deny! "t/*")  ;; Deny t/* but allow *.gl should still work for t/*.gl

(print "Allow *.gl, deny t/* - checking t/test.gl:")
(print (file-exists? "t/test.gl"))  ;; Should work because allow takes priority

(print "\n===== All Sandbox Tests Complete =====")
