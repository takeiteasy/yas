(import (gold base))
(import (gold test))
(import (gold hash))
(import (gold vector))

(test "Serialization"
  ;; Primitives
  (check (serialize 123) "123")
  (check (serialize 3.5) "3.5") 
  (check (serialize "hello") "\"hello\"")
  (check (serialize :key) ":KEY")
  (check (serialize 'sym) "SYM")
  (check (serialize t) "T")
  (check (serialize nil) "nil")
  
  ;; Vectors
  (check (serialize #(1 2)) "#(1 2)")
  (check (serialize #(:a "b")) "#(:A \"b\")")
  
  ;; Lists (serialized as vectors)
  (check (serialize '(1 2)) "#(1 2)")
  (check (serialize '(1)) "#(1)")
  
  ;; Hash Tables
  (let ((h (make-hash)))
    (check (serialize h) "()")
    (hash-set! h :k 1)
    (check (serialize h) "(:K 1)"))
  
  ;; Nested
  (let ((h (make-hash)))
    (hash-set! h :vec #(1 2))
    (check (serialize h) "(:VEC #(1 2))"))
  
  (check (serialize #(:a "text")) "#(:A \"text\")")
)

(test "Deserialization"
  ;; Primitives
  (check (deserialize "123") 123)
  (check (deserialize "\"hello\"") "hello")
  (check (deserialize ":key") :KEY)
  
  ;; Vectors
  (check (deserialize "#(1 2)") #(1 2))
  
  ;; Hash Tables
  (let ((h (deserialize "(:k 1)")))
    (check (hash? h) t)
    (check (hash-ref h :k) 1))
    
  (let ((h (deserialize "(:a 1 :b 2)")))
    (check (hash? h) t)
    (check (hash-ref h :a) 1)
    (check (hash-ref h :b) 2))
    
  ;; Nested
  (let ((h (deserialize "(:v #(1 2))")))
    (check (hash? h) t)
    (check (hash-ref h :v) #(1 2)))
    
  ;; Round trip
  (let ((data #(:a 1 :b "s")))
    (check (equal? (deserialize (serialize data)) data) t))
    
  ;; Verify list in input becomes hash
  (let ((h (deserialize "(:x 10)")))
    (check (hash? h) t)
    (check (hash-ref h :x) 10))
    
  ;; Verify vector in input remains vector
  (check (vector? (deserialize "#(1 2)")) t)
)

(test "Deserialization with Quoted Input"
  (let ((h (deserialize '(:key 100 :val 200))))
    (check (hash? h) t)
    (check (hash-ref h :key) 100)
    (check (hash-ref h :val) 200))
    
  (let ((h (deserialize '(:nested (:a 1)))))
    (check (hash? h) t)
    (check (hash? (hash-ref h :nested)) t)
    (check (hash-ref (hash-ref h :nested) :a) 1))
    
  ;; Vector with list inside - list should become hash
  (let ((v (deserialize (vector '(:name "test")))))
    (check (vector? v) t)
    (check (hash? (vector-ref v 0)) t)
    (check (hash-ref (vector-ref v 0) :name) "test"))
)

(run-tests)
