(import (gold base))
(import (gold math))
(import (gold hash))
(import (gold vector))
(import (gold text))
(import (gold test))

(print "Running Gold Test Suite...")

(test "Arithmetic"
  (check (+ 1 2) 3)
  (check (- 5 2) 3)
  (check (* 3 4) 12)
  (check (/ 10 2) 5)
  (check (modulo 10 3) 1))

(test "Lists"
  (check (car '(1 2)) 1)
  (check (cdr '(1 2)) '(2))
  (check (cons 1 2) '(1 . 2))
  (check (list 1 2 3) '(1 2 3))
  (check (append '(1) '(2)) '(1 2))
  (check (reverse '(1 2 3)) '(3 2 1)))

(test "Control Flow"
  (check (if t 1 2) 1)
  (check (if nil 1 2) 2)
  (check (cond (nil 1) (t 2)) 2)
  ;; when/unless return nil or result
  (check (when t 1) 1)
  (check (unless nil 1) 1))

(test "Vectors"
  (let ((v (make-vector 3 0)))
    (check (vector? v) t)
    (check (vector-length v) 3)
    (vector-set! v 0 10)
    (check (vector-ref v 0) 10)
    (check v #(10 0 0))))

(test "Hash Tables"
  (let ((h (make-hash)))
    (check (hash? h) t)
    (hash-set! h 'foo 123)
    (check (hash-ref h 'foo) 123)
    (check (hash-ref h 'bar 404) 404)
    (hash-remove! h 'foo)
    (check (hash-ref h 'foo 'missing) 'missing)))

(test "Lambdas and Closures"
  (let ((add1 (lambda (x) (+ x 1))))
    (check (add1 5) 6))
  (let ((counter (let ((count 0)) (lambda () (set! count (+ count 1)) count))))
    (check (counter) 1)
    (check (counter) 2)))

(test "Metatables"
  (let ((h (make-hash))
        (mt (make-hash)))
    
    (hash-set! h 'val 10)
    (set-metatable! h mt)

    ;; Test ~add operator
    (hash-set! mt '~add (lambda (self other) 
                            (+ (hash-ref self 'val) other)))
    (check (+ h 5) 15)

    ;; Test ~call
    (hash-set! mt '~call (lambda (self . args)
                            (cons 'called args)))
    (check (h 1 2) '(called 1 2))
    
    ;; Remove ~call to test ~missing (otherwise ~call takes precedence)
    (hash-remove! mt '~call) 

    ;; Test ~missing
    (hash-set! mt '~missing (lambda (self key)
                               (list 'missing key)))
    (check (h 'unknown) '(missing (unknown)))))

(test "call/cc"
  (check (call/cc (lambda (k) (k 42))) 42)
  (check (+ 1 (call/cc (lambda (k) (+ 2 (k 3))))) 4)
  
  (let ((saved-k nil))
     (call/cc (lambda (k) (set! saved-k k)))
     (if saved-k
         (let ((k saved-k))
           (set! saved-k nil)
           (k 100))
         nil)
     (check t t)) )

(test "Exceptions"
  (check (try
           (error "oops")
           (catch e e))
         "oops")

  (check (try
            (throw 'my-error)
            (catch e e))
          'my-error)

  (check (try
           10
           (catch e 20))
         10)

  ;; finally
  (let ((side-effect 0))
    (try
      (throw 'err)
      (catch e nil)
      (finally (set! side-effect 1)))
    (check side-effect 1)))

(test "Docstrings"
  ;; Function with docstring
  (define (documented x) "This is documented" x)
  (check (procedure-doc documented) "This is documented")
  
  ;; Function without docstring  
  (define (undocumented x) x)
  (check (procedure-doc undocumented) nil)
  
  ;; Lambda with docstring
  (let ((f (lambda (x) "A lambda docstring" x)))
    (check (procedure-doc f) "A lambda docstring"))
  
  ;; Multi-expression body with docstring
  (define (multi-body a b)
    "Adds two numbers and prints result"
    (print a "+" b)
    (+ a b))
  (check (procedure-doc multi-body) "Adds two numbers and prints result"))

;; SIMD Vector/Matrix Tests
(test "SIMD Vectors"
  ;; Type predicates
  (check (vec2? #vec(1 2)) t)
  (check (vec3? #vec(1 2 3)) t)
  (check (vec4? #vec(1 2 3 4)) t)
  (check (mat4? (mat4-identity)) t)
  (check (vec2? #vec(1 2 3)) nil)
  (check (vec3? #vec(1 2)) nil)
  
  ;; Constructors
  (check (vec2? (vec2 1 2)) t)
  (check (vec3? (vec3 1 2 3)) t)
  (check (vec4? (vec4 1 2 3 4)) t)
  
  ;; Component accessors
  (check (vec-x #vec(10 20)) 10.0)
  (check (vec-y #vec(10 20)) 20.0)
  (check (vec-z #vec(1 2 3)) 3.0)
  (check (vec-w #vec(1 2 3 4)) 4.0)
  (check (vec-ref #vec(5 6 7) 1) 6.0)
  
  ;; Vector arithmetic
  (check (+ #vec(1 2) #vec(3 4)) #vec(4 6))
  (check (+ #vec(1 2 3) #vec(4 5 6)) #vec(5 7 9))
  (check (+ #vec(1 2) 10) #vec(11 12))
  (check (+ 10 #vec(1 2)) #vec(11 12)))

;; Hash literal syntax
(test "#hash Literal"
  (let ((h #hash(:name "test" :value 42)))
    (check (hash? h) t)
    (check (hash-ref h 'NAME) "test")
    (check (hash-ref h 'VALUE) 42)))

;; Additional Vector Arithmetic Tests
(test "Vector Subtraction"
  (check (- #vec(5 7) #vec(2 3)) #vec(3 4))
  (check (- #vec(10 20 30) 5) #vec(5 15 25)))

(test "Vector Multiplication"
  (check (* #vec(2 3) #vec(4 5)) #vec(8 15))
  (check (* #vec(1 2 3) 2) #vec(2 4 6))
  (check (* 3 #vec(2 2 2)) #vec(6 6 6)))

(test "Vector Division"
  (check (/ #vec(10 20) #vec(2 4)) #vec(5 5))
  (check (/ #vec(6 12 18) 3) #vec(2 4 6)))

(test "vec-set!"
  (let ((v (vec3 1 2 3)))
    (vec-set! v 1 99)
    (check (vec-y v) 99)))

(test "Matrix Operations"
  (let ((id (mat4-identity)))
    (check (mat4? id) t)
    (check (mat4? (mat4-transpose id)) t)
    (check (mat4? (mat4* id id)) t)
    (check (mat4? (mat4-inverse id)) t)))

(run-tests)


