(define-library (t test)
  (import (gold base))
  (export check test run-tests *passes* *fails* *current-test-name* equal? set-test-name! report-success report-failure)
  (begin
    (define *passes* 0)
    (define *fails* 0)
    (define *current-test-name* "unknown")

    (define (set-test-name! name)
      (set! *current-test-name* name))

    (define (report-success expr expected)
     (print "  [PASS]" expr "=>" expected)
     (set! *passes* (+ *passes* 1)))

    (define (report-failure expr expected actual)
     (print "  [FAIL]" "Expected:" expected "Got:" actual "in" expr)
     (set! *fails* (+ *fails* 1)))

    (defmacro (check expr expected)
      `(let ((val ,expr) (exp ,expected))
         (if (equal? val exp)
             (report-success ',expr exp)
             (report-failure ',expr exp val))))

    (define (equal? a b)
      (cond
        ((eq? a b) t)
        ;; Numeric comparison - = handles int/float coercion
        ((and (or (float? a) (integer? a)) 
              (or (float? b) (integer? b)))
         (= a b))
        ((and (string? a) (string? b))
         (string=? a b))
        ((and (pair? a) (pair? b))
         (and (equal? (car a) (car b))
              (equal? (cdr a) (cdr b))))
        ((and (vector? a) (vector? b))
         (let ((len (length a)))
           (and (= len (length b))
                (let loop ((idx 0))
                  (if (< idx len)
                      (if (equal? (vector-ref a idx) (vector-ref b idx))
                          (loop (+ idx 1))
                          nil)
                      t)))))
        ;; SIMD vec comparison
        ((and (vec2? a) (vec2? b))
         (and (= (vec-x a) (vec-x b)) (= (vec-y a) (vec-y b))))
        ((and (vec3? a) (vec3? b))
         (and (= (vec-x a) (vec-x b)) (= (vec-y a) (vec-y b)) (= (vec-z a) (vec-z b))))
        ((and (vec4? a) (vec4? b))
         (and (= (vec-x a) (vec-x b)) (= (vec-y a) (vec-y b))
              (= (vec-z a) (vec-z b)) (= (vec-w a) (vec-w b))))
         ;; Atom equality fallback
         (t nil)))

    (defmacro (test name . body)
      `(begin
         (print "Test:" ,name)
         (set-test-name! ,name)
         ,@body))

    (define (run-tests)
      (print "---------------------------------------------------")
      (print "Test Results:")
      (print "Passed:" *passes*)
      (print "Failed:" *fails*)
      (if (> *fails* 0)
          (print "SOME TESTS FAILED")
          (print "ALL TESTS PASSED")))))
