(import (gold base))

(print "Manual vector check:")
(define v1 #(1 2 3))
(define v2 #(1 2 3))
(define v3 #(1 0 3))

(print "v1:" v1)
(print "v2:" v2)
(print "equal? v1 v2 =>" (equal? v1 v2))
(print "equal? v1 v3 =>" (equal? v1 v3))

(print "Vectors test logic check:")
(let ((v (make-vector 3 0)))
  (vector-set! v 0 10)
  (print "v modified:" v)
  (print "equal? v #(10 0 0) =>" (equal? v #(10 0 0))))
